# infra/docker/Dockerfile.ui
#
# Production image for the MCP Investment Copilot React UI.
#
# Serves the pre-built static React app (ui-react/build/) via nginx.
# The build/ folder must exist before building this image:
#   cd ui-react && npm run build
#
# Run locally to verify before pushing to ECR:
#   docker build -f infra/docker/Dockerfile.ui -t mcp-copilot-ui:local .
#   docker run --rm -p 3000:80 mcp-copilot-ui:local

FROM nginx:alpine

# Remove default nginx placeholder page
RUN rm -rf /usr/share/nginx/html/*

# Copy the React production build
COPY ui-react/build/ /usr/share/nginx/html/

# nginx config — serve index.html for all routes (React Router SPA behaviour)
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]